rectangle "Hệ thống BrewLite" {
  usecase "UC-02 Xem menu,\ntìm kiếm, lọc danh mục" as UC02
  usecase "UC-03 Tùy biến size & topping" as UC03
  usecase "UC-04 Quản lý giỏ hàng" as UC04
  usecase "UC-05 Đăng ký / Đăng nhập" as UC05
  usecase "UC-01 Đặt và thanh toán\nđơn hàng (trọng tâm)" as UC01 #FFEDD5
  usecase "UC-06 Áp dụng mã giảm giá" as UC06
  usecase "UC-07 Theo dõi trạng thái đơn" as UC07
  usecase "UC-08 Xem lịch sử đơn" as UC08
  usecase "UC-09 Hủy đơn chưa thanh toán" as UC09
  usecase "UC-10 Quản lý pha chế trên KDS\n(chỉ tài khoản STAFF)" as UC10
}

Customer --> UC02
Customer --> UC04
Customer --> UC05
Customer --> UC01
Customer --> UC07
Customer --> UC08
Customer --> UC09

Barista --> UC05
Barista --> UC10

UC01 --> Payment

