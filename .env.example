# =======================================
# BREWLITE MONOREPO ENVIRONMENT VARIABLES
# Sao chép thành .env rồi đổi các giá trị bí mật. KHÔNG commit file .env
# =======================================

# Database (PostgreSQL)
POSTGRES_USER=brewuser
POSTGRES_PASSWORD=brewpass
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432

# API (NestJS)
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Web (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
